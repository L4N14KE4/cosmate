{
  "name": "cosmate",
  "private": true,
  "scripts": {
    "build": "esbuild src/content.ts src/popup.ts src/background.ts src/welcome.ts --bundle --outdir=js --target=chrome120 --define:FULL=true",
    "watch": "npm run build -- --watch",
    "check": "tsc --noEmit",
    "zip": "npm run check && node scripts/pack.mjs",
    "zip:full": "npm run check && node scripts/pack.mjs full"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
