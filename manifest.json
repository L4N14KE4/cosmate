{
  "manifest_version": 3,
  "name": "코스모스 LXP 도우미",
  "version": "0.1",
  "description": "코스모스 LMS(신버전)용 비공식 학습 보조 도구",
  "icons": { "128": "cosmos-lxp-logo.png" },
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "notifications", "scripting"],
  "host_permissions": ["*://*/*"],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["settings.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://*/*"],
      "js": ["vod.js"]
    }
  ]
}
