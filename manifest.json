{
  "manifest_version": 3,
  "name": "코스모스 도우미",
  "version": "0.3.0",
  "description": "코스모스 LMS(신버전) 학습 보조 도구",
  "icons": { "128": "icon.png" },
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "notifications", "activeTab", "scripting"],
  "host_permissions": ["*://*/*"],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["settings.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://*/*"],
      "js": ["vod.js"]
    }
  ]
}
